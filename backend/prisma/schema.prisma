generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// сотрудники (флористы и admin)
model User {
  id        Int      @id @default(autoincrement())
  name      String
  pin       String   @unique // хэшированный smart пин-код для входа
  role      String   @default("FLORIST") // Роли: ADMIN или FLORIST
  createdAt DateTime @default(now())

  remindersCreated Reminder[]
  ordersCreated    Order[]
}

// клиенты магазина
model Client {
  id          Int           @id @default(autoincrement())
  name        String?       // необязательно
  phone       String        @unique
  ordersCount Int           @default(0)

  orders      Order[]
  events      ClientEvent[]
  reminders   Reminder[]

  createdAt   DateTime      @default(now())
}

// напоминания по клиентам (shop-wide)
model Reminder {
  id          Int       @id @default(autoincrement())
  note        String
  remindAt    DateTime
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  clientId    Int
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
}

// Поводы для покупки (Дни рождения близких, годовщины)
model ClientEvent {
  id          Int      @id @default(autoincrement())
  title       String   // "День рождения мамы", "Годовщина"
  date        DateTime

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
}

// склад (цветы, упаковка, ленты, услуги)
model Item {
  id          Int         @id @default(autoincrement())
  name        String
  category    String      // 'FLOWER', 'PACKAGING', 'SERVICE'
  imageUrl    String?
  quantity    Int         @default(0)
  costPrice   Int         @default(0) // NEW: Себестоимость
  price       Int         @default(0)
  isActive  Boolean  @default(true)

  // связи
  orderItems      OrderItem[]
  usedInBouquets  BouquetIngredient[] // связь: в каких шаблонах букетов используется
}

// NEW: Шаблон Букета (Витринный образец / карта)
model BouquetTemplate {
  id          Int      @id @default(autoincrement())
  name        String   // "Букет Нежность", "101 Роза"
  imageUrl    String?
  price       Int
  isActive  Boolean  @default(true)

  ingredients   BouquetIngredient[]
  orderBouquets OrderBouquet[]      // связь с проданными букетами
}

// NEW: Ингредиенты рецепта (Состав шаблона букета)
model BouquetIngredient {
  id                Int      @id @default(autoincrement())
  quantity          Int      // Количество (например, 15 роз)

  bouquetTemplateId Int
  bouquetTemplate   BouquetTemplate @relation(fields: [bouquetTemplateId], references: [id])

  itemId            Int
  item              Item     @relation(fields: [itemId], references: [id])
}

// заказы
model Order {
  id          Int         @id @default(autoincrement())
  totalPrice  Int
  source      String      // 'INSTAGRAM', 'WHATSAPP', '2GIS', 'WALK_IN'
  status      String      @default("COMPLETED") // 'PENDING', 'COMPLETED', 'CANCELLED'

  // ручная %‑скидка (POS: клиент показал обещание в WhatsApp и т.п.)
  discountPercent Int?    // null = без ручной %
  discountAmount  Int     @default(0) // сумма ручной % скидки

  clientId    Int?        // ссылка на клиента (может быть пустым)
  client      Client?     @relation(fields: [clientId], references: [id])

  // кто оформил заказ (сотрудник из JWT)
  createdById Int?
  createdBy   User?       @relation(fields: [createdById], references: [id])

  // NEW: состав заказа теперь делится на поштучные товары и готовые букеты
  items       OrderItem[]
  bouquets    OrderBouquet[]

  createdAt   DateTime    @default(now())
}

// состав заказа (промежуточная таблица для списания поштучного товара)
model OrderItem {
  id          Int   @id @default(autoincrement())

  orderId     Int
  order       Order @relation(fields: [orderId], references: [id])

  itemId      Int
  item        Item  @relation(fields: [itemId], references: [id])

  quantity    Int
  priceAtSale Int   // фиксируем цену на момент продажи
}

// NEW: Промежуточная таблица для проданных букетов в заказе
model OrderBouquet {
  id                Int      @id @default(autoincrement())
  quantity          Int
  priceAtSale       Int      // Фиксируем цену букета на момент продажи

  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id])

  bouquetTemplateId Int
  bouquetTemplate   BouquetTemplate @relation(fields: [bouquetTemplateId], references: [id])
}
